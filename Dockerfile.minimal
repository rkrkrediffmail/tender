FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Install only essential system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/cache/apt/*

# Copy and install minimal requirements first
COPY requirements_minimal.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements_minimal.txt \
    && pip cache purge

# Copy application code (excluding heavy files)
COPY *.py ./
COPY templates/ ./templates/
COPY uploads/ ./uploads/ 2>/dev/null || mkdir -p uploads
COPY logs/ ./logs/ 2>/dev/null || mkdir -p logs

# Create necessary directories
RUN mkdir -p uploads logs vector_storage

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Expose port
EXPOSE 5000

# Default command
CMD ["python", "main.py"]